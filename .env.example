# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=effectiv_user
DB_PASSWORD=effectiv_password
DB_NAME=effectiv_crm

# Alternative PostgreSQL Password (used in Docker Compose)
POSTGRES_PASSWORD=effectiv_password

# Application Environment
NODE_ENV=development

# Database Pool Configuration (optional - defaults provided)
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_ACQUIRE_TIMEOUT=30000
DB_POOL_CREATE_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=30000

# Development Settings
DB_DEBUG=true
DB_AUTO_LOAD_ENTITIES=true

# Production Settings (set these in production)
# DB_HOST=your-production-host
# DB_PORT=5432
# DB_USER=your-production-user
# DB_PASSWORD=your-secure-production-password
# DB_NAME=effectiv_crm_prod
# NODE_ENV=production
# DB_DEBUG=false
# DB_AUTO_LOAD_ENTITIES=false
