# Development Environment Configuration
NODE_ENV=development

# Use SQLite for local development
DB_TYPE=sqlite
SQLITE_DB_PATH=./data/effectiv-crm-dev.db
SQLITE_IN_MEMORY=false

# PostgreSQL Configuration (if DB_TYPE=postgresql)
DB_HOST=localhost
DB_PORT=5432
DB_USER=effectiv_user
DB_PASSWORD=effectiv_password
DB_NAME=effectiv_crm
POSTGRES_PASSWORD=effectiv_password

# Development-specific Database Settings
DB_DEBUG=true
DB_AUTO_LOAD_ENTITIES=true

# Database Pool Configuration
DB_POOL_MIN=2
DB_POOL_MAX=10
